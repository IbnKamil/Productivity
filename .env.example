ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://tunnel:tunnel@postgres:5432/tunnel
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
SENTRY_DSN=
NEXT_PUBLIC_API_URL=http://localhost:8000
POSTGRES_DB=tunnel
POSTGRES_USER=tunnel
POSTGRES_PASSWORD=tunnel
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-password

# Optional AI decomposition. Leave OPENAI_API_KEY empty to use the local fallback.
TASK_DECOMPOSER_MODE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MIN_MICRO_TASKS=10
MAX_MICRO_TASKS=150
